{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "plugins": [{ "name": "next" }],
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "playwright-production-identity.ts",
    "playwright.workspace-production.ts",
    "browser-tests-workspace-production/**/*.ts",
    "playwright-web-server.ts",
    "run-browser-tests.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
