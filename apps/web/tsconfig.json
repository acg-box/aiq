{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "plugins": [{ "name": "next" }],
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "browser-tests*/**/*.ts",
    "browser-tests*/**/*.mjs",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
