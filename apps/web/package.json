{
  "name": "@aiq/web",
  "version": "0.1.0",
  "private": true,
  "description": "AIQ public benchmark history and distributed radar interface",
  "homepage": "https://aiq.wiki",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/acg-box/aiq.git",
    "directory": "apps/web"
  },
  "type": "module",
  "scripts": {
    "build": "node --max-old-space-size=512 ../../node_modules/next/dist/bin/next build --webpack",
    "check": "tsc --noEmit",
    "dev": "next dev",
    "start": "next start",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"src/**/*.test.ts\"",
    "test:browser": "node run-browser-tests.ts",
    "test:browser:prebuilt": "node run-browser-tests.ts --prebuilt",
    "test:browser:synthetic": "playwright test",
    "test:browser:invalid-config": "playwright test --config playwright.invalid-config.ts",
    "test:browser:live-empty": "playwright test --config playwright.live-empty.ts",
    "test:browser:live-stack": "playwright test --config playwright.live-stack.ts",
    "test:browser:live-published": "playwright test --config playwright.live-published.ts",
    "test:browser:malformed-config": "playwright test --config playwright.malformed-config.ts",
    "test:browser:missing-config": "playwright test --config playwright.missing-config.ts",
    "test:browser:production-contract": "playwright test --config playwright.production-mock.ts",
    "test:browser:production": "playwright test --config playwright.production.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.110.8",
    "echarts": "6.1.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.17.0"
  }
}
