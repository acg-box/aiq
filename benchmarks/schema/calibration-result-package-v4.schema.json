{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiq.wiki/schema/calibration-result-package-v4.schema.json",
  "title": "AIQ signed non-Official calibration package v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "idempotency_key",
    "payload_type",
    "content_hash",
    "signer",
    "claimed_trust",
    "payload",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "aiq.result-package.v4" },
    "idempotency_key": { "type": "string", "pattern": "^run_[a-f0-9]{64}(?![\\s\\S])" },
    "payload_type": { "const": "aiq.calibration-run.v4" },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])" },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "public_key"],
      "properties": {
        "node_id": { "type": "string", "pattern": "^node_[a-f0-9]{64}(?![\\s\\S])" },
        "public_key": { "type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])" }
      }
    },
    "claimed_trust": { "const": "untrusted" },
    "payload": { "$ref": "calibration-run-v4.schema.json" },
    "signature": { "type": "string", "pattern": "^[a-f0-9]{128}(?![\\s\\S])" }
  }
}
