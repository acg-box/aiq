{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiq.wiki/schema/catalog.v1.json",
  "title": "AIQ public benchmark catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_set_id",
    "task_set_version",
    "title",
    "status",
    "generated_from",
    "identity_commitment",
    "content_policy",
    "distribution",
    "tasks"
  ],
  "properties": {
    "schema_version": { "const": "aiq.catalog.v1" },
    "task_set_id": { "type": "string", "minLength": 1 },
    "task_set_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])"
    },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "const": "public_designs_versioned_private_content_required"
    },
    "generated_from": { "type": "string", "minLength": 1 },
    "identity_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "scope"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": {
          "type": "string",
          "pattern": "^sha256:(?!0{64}(?![\\s\\S]))[0-9a-f]{64}(?![\\s\\S])"
        },
        "scope": { "const": "ordered_full_task_metadata" }
      }
    },
    "content_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_repository", "controlled_source"],
      "properties": {
        "public_repository": { "type": "string", "minLength": 1 },
        "controlled_source": { "type": "string", "minLength": 1 }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "domains", "difficulties", "domain_difficulty", "difficulty_role"],
      "properties": {
        "total": { "const": 72 },
        "domains": { "type": "object" },
        "difficulties": { "type": "object" },
        "domain_difficulty": { "type": "object" },
        "difficulty_role": { "type": "string", "minLength": 1 }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 72,
      "maxItems": 72,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_version",
        "title",
        "domain",
        "difficulty",
        "summary",
        "input_contract",
        "cluster_id",
        "allowed_tools",
        "budget",
        "evaluator",
        "tags",
        "visibility",
        "provenance",
        "leakage_review"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+-[0-9]{2}(?![\\s\\S])"
        },
        "task_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "title": { "type": "string", "minLength": 12 },
        "domain": {
          "enum": [
            "coding",
            "debugging",
            "repository_understanding",
            "data_processing",
            "retrieval_verification",
            "documentation_communication",
            "planning_execution",
            "tool_use",
            "instruction_following",
            "reliability_recovery"
          ]
        },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "summary": { "type": "string", "minLength": 30 },
        "input_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fixture_profile", "content_handle"],
          "properties": {
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"
            },
            "fixture_profile": {
              "type": "string",
              "pattern": "^aiq-fixture://[a-z0-9-]+-[0-9]{2}/v1(?![\\s\\S])"
            },
            "content_handle": {
              "type": "string",
              "pattern": "^aiq-controlled-task://aiq-core/1\\.0\\.0/[a-z0-9-]+-[0-9]{2}(?![\\s\\S])"
            }
          }
        },
        "cluster_id": {
          "type": "string",
          "pattern": "^[a-z_]+-cluster-[0-9]{2}(?![\\s\\S])"
        },
        "allowed_tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "filesystem_read",
              "filesystem_write",
              "web_search",
              "command_execution"
            ]
          },
          "not": {
            "allOf": [
              { "type": "array", "contains": { "const": "none" } },
              { "type": "array", "minItems": 2 }
            ]
          },
          "allOf": [
            {
              "if": {
                "type": "array",
                "contains": { "const": "command_execution" }
              },
              "then": {
                "type": "array",
                "contains": { "enum": ["filesystem_read", "filesystem_write"] }
              }
            }
          ]
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wall_seconds", "max_steps", "max_tool_calls"],
          "properties": {
            "wall_seconds": { "type": "integer", "minimum": 60 },
            "max_steps": { "type": "integer", "minimum": 1 },
            "max_tool_calls": { "type": "integer", "minimum": 0 }
          }
        },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "scorer_version",
            "execution_protocol",
            "binding_requirement",
            "deterministic",
            "partial_credit",
            "pass_conditions",
            "acceptance_fixture_commitments"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"
            },
            "scorer_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
            },
            "execution_protocol": { "const": "aiq.evaluator-protocol.v1" },
            "binding_requirement": { "const": "controlled_hidden_task_required" },
            "deterministic": { "const": true },
            "partial_credit": { "type": "boolean" },
            "pass_conditions": {
              "type": "array",
              "minItems": 3,
              "items": { "type": "string", "minLength": 8 }
            },
            "acceptance_fixture_commitments": {
              "$ref": "#/$defs/acceptanceFixtureCommitments"
            }
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"
          }
        },
        "visibility": { "const": "hidden" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "owner", "recorded_date", "source"],
          "properties": {
            "origin": { "const": "original_benchmark_design" },
            "owner": { "const": "AIQ benchmark maintainers" },
            "recorded_date": { "type": "string", "format": "date" },
            "source": { "const": "scripts/generate-benchmark-catalog.ts" }
          }
        },
        "leakage_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "owner", "review_requirement", "notes"],
          "properties": {
            "status": {
              "const": "public_design_versioned_private_content_required"
            },
            "owner": { "const": "AIQ benchmark maintainers" },
            "review_requirement": {
              "const": "private_corpus_tests_and_catalog_binding_required"
            },
            "notes": { "type": "string", "minLength": 80 }
          }
        }
      }
    },
    "acceptanceFixtureCommitments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gold",
        "alternate_correct",
        "partial",
        "adversarial_format",
        "empty",
        "timeout"
      ],
      "properties": {
        "gold": { "$ref": "#/$defs/acceptanceFixtureCommitment" },
        "alternate_correct": { "$ref": "#/$defs/acceptanceFixtureCommitment" },
        "partial": { "$ref": "#/$defs/acceptanceFixtureCommitment" },
        "adversarial_format": {
          "description": "Combined adversarial-content and output-format-attack fixture.",
          "$ref": "#/$defs/acceptanceFixtureCommitment"
        },
        "empty": { "$ref": "#/$defs/acceptanceFixtureCommitment" },
        "timeout": { "$ref": "#/$defs/acceptanceFixtureCommitment" }
      }
    },
    "acceptanceFixtureCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "status"],
      "properties": {
        "handle": {
          "type": "string",
          "pattern": "^aiq-acceptance://[a-z0-9-]+-[0-9]{2}/v1/(?:gold|alternate-correct|partial|adversarial-format|empty|timeout)(?![\\s\\S])"
        },
        "status": { "const": "required_in_controlled_source" }
      }
    }
  }
}
