          "items": false
        }
      }
    },
    "contrast_bindings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/contrast"
      }
    },
    "signer": {
      "$ref": "#/$defs/signer"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}(?![\\s\\S]))[a-f0-9]{64}(?![\\s\\S])"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==(?![\\s\\S])"
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm"],
      "properties": {
        "key_id": {
          "$ref": "#/$defs/identifier"
        },
        "algorithm": {
          "const": "ed25519"
        }
      }
    },
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeat_id", "scheduled_at", "contrast_arm_order"],
      "properties": {
        "repeat_id": {
          "$ref": "#/$defs/identifier"
        },
        "scheduled_at": {
          "$ref": "#/$defs/timestamp"
        },
        "contrast_arm_order": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(coupled_constraints|ambiguous_recovery_state|plausible_incomplete_evidence):(reference|challenge)(?![\\s\\S])"
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "execution_model_id", "family", "reasoning_effort"],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/identifier"
        },
        "execution_model_id": {
          "$ref": "#/$defs/identifier"
        },
        "family": {
          "enum": ["sol", "terra", "luna"]
        },
        "reasoning_effort": {
          "enum": ["low", "medium", "high", "xhigh", "max", "ultra"]
        }
      }
    },
    "contrast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contrast_id", "reference_variant_digest", "challenge_variant_digest"],
      "properties": {
        "contrast_id": {
          "$ref": "#/$defs/identifier"
        },
        "reference_variant_digest": {
          "$ref": "#/$defs/digest"
        },
        "challenge_variant_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
