  "additionalProperties": false,
  "required": [
    "schema_version",
    "signature_domain",
    "signature_encoding",
    "release_identity",
    "catalog_release_identity_digest",
    "task_metadata_identity_digest",
    "corpus_commitment_digest",
    "plan_id",
    "execution_plan_digest",
    "model_id_mapping_digest",
    "issued_at",
    "collection_not_before",
    "collection_not_after",
    "repeat_schedule",
    "observation_universe",
    "infrastructure_retry_policy",
    "model_matrix",
    "contrast_bindings",
    "signer",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "aiq.release-gate-admission.v1"
    },
    "signature_domain": {
      "const": "aiq.release-gate-admission.v1"
    },
    "signature_encoding": {
      "const": "aiq.sorted-key-json.v1"
    },
    "release_identity": {
      "const": "aiq-core/1.0.2"
    },
    "catalog_release_identity_digest": {
      "const": "sha256:45bf2e9d5287fd4f83e46bc3cb5c3ccb8778756465e81bfd567d111480eefc4b"
    },
    "task_metadata_identity_digest": {
      "const": "sha256:2c5efe162b49e710e6e52b0f3a4e33d1127d0dd54d4f15694f88911bcb7fc937"
    },
    "corpus_commitment_digest": {
      "$ref": "#/$defs/digest"
    },
    "plan_id": {
      "$ref": "#/$defs/identifier"
    },
    "execution_plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "model_id_mapping_digest": {
      "$ref": "#/$defs/digest"
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "collection_not_before": {
      "$ref": "#/$defs/timestamp"
    },
    "collection_not_after": {
      "$ref": "#/$defs/timestamp"
    },
    "repeat_schedule": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repeat"
      }
    },
    "observation_universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_ids",
        "model_ids",
        "raw_cell_count",
        "contrast_pair_count",
        "contrast_observation_count"
      ],
      "properties": {
        "task_ids": {
          "type": "array",
          "minItems": 72,
          "maxItems": 72,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "model_ids": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "raw_cell_count": {
          "const": 3672
        },
        "contrast_pair_count": {
          "const": 153
        },
        "contrast_observation_count": {
          "const": 306
        }
      }
    },
    "infrastructure_retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "backoff_seconds",
        "retryable_classifications",
        "model_or_evaluator_failures_retryable"
      ],
      "properties": {
        "max_attempts": {
          "const": 3
        },
        "backoff_seconds": {
          "const": [0, 30, 90]
        },
        "retryable_classifications": {
          "const": ["pre_model_admission"]
        },
        "model_or_evaluator_failures_retryable": {
          "const": false
        }
      }
    },
