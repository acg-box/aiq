{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiq.wiki/schema/release-gate-authority.v1.json",
  "title": "Signed post-collection AIQ Core release authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signature_domain",
    "signature_encoding",
    "release_identity",
    "catalog_release_identity_digest",
    "task_metadata_identity_digest",
    "admission_digest",
    "execution_plan_digest",
    "model_id_mapping_digest",
    "admission",
    "source_observations_digest",
    "signer",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "aiq.release-gate-authority.v1" },
    "signature_domain": { "const": "aiq.release-gate-authority.v1" },
    "signature_encoding": { "const": "aiq.sorted-key-json.v1" },
    "release_identity": { "const": "aiq-core/1.0.2" },
    "catalog_release_identity_digest": {
      "const": "sha256:45bf2e9d5287fd4f83e46bc3cb5c3ccb8778756465e81bfd567d111480eefc4b"
    },
    "task_metadata_identity_digest": {
      "const": "sha256:2c5efe162b49e710e6e52b0f3a4e33d1127d0dd54d4f15694f88911bcb7fc937"
    },
    "admission_digest": { "$ref": "#/$defs/digest" },
    "execution_plan_digest": { "$ref": "#/$defs/digest" },
    "model_id_mapping_digest": { "$ref": "#/$defs/digest" },
    "admission": { "$ref": "https://aiq.wiki/schema/release-gate-admission.v1.json" },
    "source_observations_digest": { "$ref": "#/$defs/digest" },
    "signer": { "$ref": "#/$defs/signer" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}(?![\\s\\S]))[a-f0-9]{64}(?![\\s\\S])"
    },
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*(?![\\s\\S])" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==(?![\\s\\S])" },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm"],
      "properties": {
        "key_id": { "$ref": "#/$defs/identifier" },
        "algorithm": { "const": "ed25519" }
      }
    }
  }
}
