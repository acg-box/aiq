{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiq.wiki/schema/workspace-snapshot-v1.schema.json",
  "title": "AIQ workspace replay snapshot v1",
  "description": "A bounded exact candidate workspace used only for claim-bound independent evaluator replay.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_sha256", "entries"],
  "properties": {
    "schema_version": { "const": "aiq.workspace-snapshot.v1" },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}(?![\\s\\S]))[a-f0-9]{64}(?![\\s\\S])"
    },
    "entries": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|(?![\\s\\S])))(?!.*\\.(?:/|(?![\\s\\S])))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|(?![\\s\\S])))[A-Za-z0-9._-]{1,255}(?:/[A-Za-z0-9._-]{1,255}){0,64}(?![\\s\\S])"
    },
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "kind"],
          "properties": {
            "path": {
              "allOf": [
                { "$ref": "#/$defs/safePath" },
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]{1,255}(?:/[A-Za-z0-9._-]{1,255}){0,63}(?![\\s\\S])"
                }
              ]
            },
            "kind": { "const": "directory" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "kind", "bytes", "sha256", "content_hex"],
          "properties": {
            "path": { "$ref": "#/$defs/safePath" },
            "kind": { "const": "file" },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1398101
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:(?!0{64}(?![\\s\\S]))[a-f0-9]{64}(?![\\s\\S])"
            },
            "content_hex": {
              "type": "string",
              "maxLength": 2796202,
              "pattern": "^(?:[a-f0-9]{2})*(?![\\s\\S])"
            }
          }
        }
      ]
    }
  },
  "x-aiq-invariants": [
    "entries are strictly ordered by path and paths are unique",
    "bytes equals decoded content_hex length",
    "sha256 commits to decoded content_hex bytes",
    "manifest_sha256 commits to the reconstructed aiq.workspace-manifest.v1 value",
    "case-insensitive path aliases are forbidden and every child has one exact earlier directory parent",
    "the aggregate path length is limited to 262144 bytes and aggregate decoded file content is limited to 1398101 bytes",
    "the canonical JSON artifact is limited to 4194304 bytes by the ingress boundary"
  ]
}
