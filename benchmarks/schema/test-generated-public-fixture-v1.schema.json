{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiq.wiki/schema/test-generated-public-fixture-v1.schema.json",
  "title": "AIQ 2.0 test-generated public projection fixture",
  "description": "Browser contract data only. The outer provenance is never eligible for production or Official publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_provenance",
    "test_generated",
    "production_publishable",
    "official_eligible",
    "ranking_eligible",
    "synthetic",
    "benchmark_version",
    "scoring_version",
    "measurement_version",
    "matrix_batch_id",
    "task_count",
    "configuration_count",
    "cell_count",
    "bootstrap_samples",
    "bootstrap_seed",
    "calibration_gate",
    "leaderboard",
    "trend",
    "task_cells"
  ],
  "properties": {
    "schema_version": { "const": "aiq.test-generated-public-fixture.v1" },
    "fixture_provenance": { "const": "test_generated" },
    "test_generated": { "const": true },
    "production_publishable": { "const": false },
    "official_eligible": { "const": false },
    "ranking_eligible": { "const": false },
    "synthetic": { "const": true },
    "benchmark_version": { "const": "aiq-core@1.0.6" },
    "scoring_version": { "const": "1.0.6" },
    "measurement_version": { "const": "2.0.0" },
    "matrix_batch_id": {
      "type": "string",
      "pattern": "^fixture_[a-f0-9]{64}(?![\\s\\S])"
    },
    "task_count": { "const": 72 },
    "configuration_count": { "const": 17 },
    "cell_count": { "const": 1224 },
    "bootstrap_samples": { "type": "integer", "minimum": 1 },
    "bootstrap_seed": { "type": "integer", "minimum": 1 },
    "calibration_gate": { "$ref": "#/$defs/calibrationGate" },
    "leaderboard": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": { "$ref": "#/$defs/leaderboardRow" }
    },
    "trend": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": { "$ref": "#/$defs/trendRow" }
    },
    "task_cells": {
      "type": "array",
      "minItems": 1224,
      "maxItems": 1224,
      "items": { "$ref": "#/$defs/taskCell" }
    }
  },
  "$defs": {
    "matrixId": {
      "enum": [
        "sol-low",
        "sol-medium",
        "sol-high",
        "sol-xhigh",
        "sol-max",
        "sol-ultra",
        "terra-low",
        "terra-medium",
        "terra-high",
        "terra-xhigh",
        "terra-max",
        "terra-ultra",
        "luna-low",
        "luna-medium",
        "luna-high",
        "luna-xhigh",
        "luna-max"
      ]
    },
    "runId": {
      "type": "string",
      "pattern": "^run_[a-f0-9]{64}(?![\\s\\S])"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "strictCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 72
    },
    "strictSample": {
      "type": "integer",
      "minimum": 1,
      "maximum": 72
    },
    "leaderboardRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_id",
        "run_id",
        "score",
        "theta",
        "standard_error",
        "theta_ci_low",
        "theta_ci_high",
        "score_ci_low",
        "score_ci_high",
        "information",
        "quality_score",
        "strict_pass_rate",
        "strict_pass_low",
        "strict_pass_high",
        "strict_pass_sample_size",
        "strict_pass_successes",
        "reliability_status",
        "calibration_status",
        "sensitivity_low",
        "sensitivity_high",
        "sample_size",
        "coverage_percent",
        "runtime_issues",
        "missing",
        "scoring_version",
        "score_status",
        "synthetic"
      ],
      "properties": {
        "matrix_id": { "$ref": "#/$defs/matrixId" },
        "run_id": { "$ref": "#/$defs/runId" },
        "score": { "$ref": "#/$defs/score" },
        "theta": { "type": "number" },
        "standard_error": { "type": "number", "exclusiveMinimum": 0 },
        "theta_ci_low": { "type": "number" },
        "theta_ci_high": { "type": "number" },
        "score_ci_low": { "$ref": "#/$defs/score" },
        "score_ci_high": { "$ref": "#/$defs/score" },
        "information": { "type": "number", "minimum": 0, "maximum": 72 },
        "quality_score": { "$ref": "#/$defs/score" },
        "strict_pass_rate": { "$ref": "#/$defs/probability" },
        "strict_pass_low": { "$ref": "#/$defs/probability" },
        "strict_pass_high": { "$ref": "#/$defs/probability" },
        "strict_pass_sample_size": { "$ref": "#/$defs/strictSample" },
        "strict_pass_successes": { "$ref": "#/$defs/strictCount" },
        "reliability_status": { "const": "single_matrix_information_only" },
        "calibration_status": { "const": "calibrated" },
        "sensitivity_low": { "$ref": "#/$defs/score" },
        "sensitivity_high": { "$ref": "#/$defs/score" },
        "sample_size": { "const": 72 },
        "coverage_percent": { "const": 100 },
        "runtime_issues": { "const": 0 },
        "missing": { "const": 0 },
        "scoring_version": { "const": "1.0.6" },
        "score_status": { "const": "official" },
        "synthetic": { "const": false }
      }
    },
    "trendRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_id",
        "run_id",
        "scoring_version",
        "recorded_at",
        "bucket_started_at",
        "bucket_ended_at",
        "score",
        "theta",
        "standard_error",
        "theta_ci_low",
        "theta_ci_high",
        "score_ci_low",
        "score_ci_high",
        "information",
        "quality_score",
        "strict_pass_rate",
        "strict_pass_low",
        "strict_pass_high",
        "strict_pass_sample_size",
        "strict_pass_successes",
        "reliability_status",
        "calibration_status",
        "sensitivity_low",
        "sensitivity_high",
        "sample_size",
        "represented_run_count",
        "resolution_seconds",
        "synthetic"
      ],
      "properties": {
        "matrix_id": { "$ref": "#/$defs/matrixId" },
        "run_id": { "$ref": "#/$defs/runId" },
        "scoring_version": { "const": "1.0.6" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "bucket_started_at": { "type": "string", "format": "date-time" },
        "bucket_ended_at": { "type": "string", "format": "date-time" },
        "score": { "$ref": "#/$defs/score" },
        "theta": { "type": "number" },
        "standard_error": { "type": "number", "exclusiveMinimum": 0 },
        "theta_ci_low": { "type": "number" },
        "theta_ci_high": { "type": "number" },
        "score_ci_low": { "$ref": "#/$defs/score" },
        "score_ci_high": { "$ref": "#/$defs/score" },
        "information": { "type": "number", "minimum": 0, "maximum": 72 },
        "quality_score": { "$ref": "#/$defs/score" },
        "strict_pass_rate": { "$ref": "#/$defs/probability" },
        "strict_pass_low": { "$ref": "#/$defs/probability" },
        "strict_pass_high": { "$ref": "#/$defs/probability" },
        "strict_pass_sample_size": { "$ref": "#/$defs/strictSample" },
        "strict_pass_successes": { "$ref": "#/$defs/strictCount" },
        "reliability_status": { "const": "single_matrix_information_only" },
        "calibration_status": { "const": "calibrated" },
        "sensitivity_low": { "$ref": "#/$defs/score" },
        "sensitivity_high": { "$ref": "#/$defs/score" },
        "sample_size": { "const": 72 },
        "represented_run_count": { "const": 1 },
        "resolution_seconds": { "type": "integer", "minimum": 1 },
        "synthetic": { "const": false }
      }
    },
    "taskCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix_id", "task_id", "task_version", "task_score", "evaluation", "provenance"],
      "properties": {
        "matrix_id": { "$ref": "#/$defs/matrixId" },
        "task_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*-[0-9]{2}(?![\\s\\S])"
        },
        "task_version": { "const": "1.0.6" },
        "task_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "evaluation": { "enum": ["correct", "partial", "incorrect"] },
        "provenance": { "const": "test_generated" }
      }
    },
    "calibrationGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "passed", "violations"],
      "properties": {
        "policy_version": { "const": "aiq.official-calibration-policy.v1" },
        "passed": { "const": true },
        "violations": { "type": "array", "maxItems": 0 }
      }
    }
  }
}
