{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiq.wiki/schema/calibration-verified-stage-v1.schema.json",
  "title": "AIQ calibration verified stage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "package_sha256",
    "content_hash",
    "runner",
    "classification",
    "run_class",
    "official_eligible",
    "ranking_eligible",
    "trust",
    "task_set_hash",
    "task_selection_digest",
    "model_selection_digest",
    "score_reports_digest",
    "telemetry_digest",
    "capability_validation_digest",
    "provenance",
    "evaluator_results_artifact",
    "scoring_version",
    "execution_concurrency",
    "task_ids",
    "models",
    "scores",
    "result_efficiency",
    "pricing",
    "task_set_id",
    "task_set_version",
    "benchmark_version",
    "prompt_set_digest",
    "runner_commit",
    "region",
    "scheduled_unix_ms",
    "started_unix_ms",
    "finished_unix_ms",
    "stage_digest"
  ],
  "properties": {
    "schema_version": { "const": "aiq.calibration-verified-stage.v1" },
    "run_id": { "$ref": "#/$defs/runId" },
    "package_sha256": { "$ref": "#/$defs/plainHash" },
    "content_hash": { "$ref": "#/$defs/hash" },
    "runner": { "$ref": "result-package-v3.schema.json#/properties/signer" },
    "classification": { "const": "local_calibration_non_official" },
    "run_class": { "const": "calibration" },
    "official_eligible": { "const": false },
    "ranking_eligible": { "const": false },
    "trust": { "const": "untrusted" },
    "task_set_hash": { "$ref": "#/$defs/hash" },
    "task_selection_digest": { "$ref": "#/$defs/hash" },
    "model_selection_digest": { "$ref": "#/$defs/hash" },
    "score_reports_digest": { "$ref": "#/$defs/hash" },
    "telemetry_digest": { "$ref": "#/$defs/hash" },
    "capability_validation_digest": { "$ref": "#/$defs/hash" },
    "provenance": { "$ref": "calibration-run-v3.schema.json#/$defs/provenance" },
    "evaluator_results_artifact": {
      "$ref": "result-package-v3.schema.json#/$defs/evaluatorResultsArtifact"
    },
    "scoring_version": { "const": "1.0.5" },
    "execution_concurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 72,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}(?![\\s\\S])" }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 17,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/model" }
    },
    "scores": {
      "type": "array",
      "minItems": 1,
      "maxItems": 17,
      "items": { "$ref": "#/$defs/verifiedScore" }
    },
    "result_efficiency": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1224,
      "items": { "$ref": "#/$defs/resultEfficiency" }
    },
    "pricing": { "$ref": "#/$defs/pricing" },
    "task_set_id": { "const": "aiq-core" },
    "task_set_version": { "const": "1.0.5" },
    "benchmark_version": { "const": "aiq-core@1.0.5" },
    "prompt_set_digest": { "$ref": "#/$defs/hash" },
    "runner_commit": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}(?![\\s\\S])" },
    "region": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}(?![\\s\\S])" },
    "scheduled_unix_ms": { "$ref": "#/$defs/count" },
    "started_unix_ms": { "$ref": "#/$defs/count" },
    "finished_unix_ms": { "$ref": "#/$defs/count" },
    "stage_digest": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "runId": { "type": "string", "pattern": "^run_[a-f0-9]{64}(?![\\s\\S])" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])" },
    "plainHash": { "type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])" },
    "model": { "$ref": "calibration-run-v3.schema.json#/$defs/model" },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": { "$ref": "#/$defs/count" },
        "cached_input": { "$ref": "#/$defs/count" },
        "cache_write_input": { "$ref": "#/$defs/count" },
        "output": { "$ref": "#/$defs/count" },
        "reasoning": { "$ref": "#/$defs/count" },
        "total": { "$ref": "#/$defs/count" }
      }
    },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "resultEfficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_result_id",
        "task_id",
        "model",
        "observed_wall_ms",
        "wall_time_evidence_level",
        "provider_tokens",
        "provider_tokens_source",
        "provider_tokens_evidence_level",
        "standard_api_equivalent_usd_nanos",
        "cost_status",
        "cost_evidence_level"
      ],
      "properties": {
        "source_result_id": { "type": "string", "pattern": "^result_[a-f0-9]{64}(?![\\s\\S])" },
        "task_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}(?![\\s\\S])" },
        "model": { "$ref": "#/$defs/model" },
        "observed_wall_ms": { "anyOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
        "wall_time_evidence_level": { "enum": ["runner_observed", null] },
        "provider_tokens": { "$ref": "#/$defs/tokens" },
        "provider_tokens_source": { "enum": ["provider_reported", null] },
        "provider_tokens_evidence_level": { "enum": ["verifier_recomputed", null] },
        "standard_api_equivalent_usd_nanos": {
          "anyOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }]
        },
        "cost_status": {
          "enum": [
            "estimated",
            "unavailable_missing_usage",
            "unavailable_invalid_usage",
            "unavailable_context_band"
          ]
        },
        "cost_evidence_level": { "enum": ["verifier_recomputed", null] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "observed_wall_ms": { "type": "null" } },
            "required": ["observed_wall_ms"]
          },
          "then": { "properties": { "wall_time_evidence_level": { "type": "null" } } },
          "else": { "properties": { "wall_time_evidence_level": { "const": "runner_observed" } } }
        },
        {
          "if": {
            "properties": { "provider_tokens": { "minProperties": 1 } },
            "required": ["provider_tokens"]
          },
          "then": {
            "properties": {
              "provider_tokens_source": { "const": "provider_reported" },
              "provider_tokens_evidence_level": { "const": "verifier_recomputed" }
            }
          },
          "else": {
            "properties": {
              "provider_tokens_source": { "type": "null" },
              "provider_tokens_evidence_level": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "standard_api_equivalent_usd_nanos": { "type": "null" } },
            "required": ["standard_api_equivalent_usd_nanos"]
          },
          "then": {
            "properties": {
              "cost_evidence_level": { "type": "null" },
              "cost_status": {
                "enum": [
                  "unavailable_missing_usage",
                  "unavailable_invalid_usage",
                  "unavailable_context_band"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "cost_evidence_level": { "const": "verifier_recomputed" },
              "cost_status": { "const": "estimated" }
            }
          }
        },
        {
          "if": {
            "properties": { "cost_status": { "const": "unavailable_context_band" } },
            "required": ["cost_status"]
          },
          "then": {
            "properties": {
              "provider_tokens": {
                "properties": { "input": { "type": "integer", "minimum": 272001 } },
                "required": ["input", "cached_input", "cache_write_input", "output"]
              },
              "standard_api_equivalent_usd_nanos": { "type": "null" },
              "cost_evidence_level": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider_tokens": {
                "properties": { "input": { "type": "integer", "minimum": 272001 } },
                "required": ["input", "cached_input", "cache_write_input", "output"]
              }
            },
            "required": ["provider_tokens"]
          },
          "then": {
            "properties": { "cost_status": { "const": "unavailable_context_band" } }
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_tasks",
        "input_tasks",
        "cached_input_tasks",
        "cache_write_input_tasks",
        "output_tasks",
        "reasoning_tasks",
        "total_tasks"
      ],
      "properties": {
        "selected_tasks": { "$ref": "#/$defs/count" },
        "input_tasks": { "$ref": "#/$defs/count" },
        "cached_input_tasks": { "$ref": "#/$defs/count" },
        "cache_write_input_tasks": { "$ref": "#/$defs/count" },
        "output_tasks": { "$ref": "#/$defs/count" },
        "reasoning_tasks": { "$ref": "#/$defs/count" },
        "total_tasks": { "$ref": "#/$defs/count" }
      }
    },
    "efficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "model",
        "selected_tasks",
        "observed_wall_tasks",
        "total_observed_wall_ms",
        "median_observed_wall_ms",
        "p95_observed_wall_ms",
        "provider_token_totals",
        "provider_token_coverage",
        "estimated_cost_tasks",
        "standard_api_equivalent_usd_nanos"
      ],
      "properties": {
        "schema_version": { "const": "aiq.calibration-efficiency.v1" },
        "model": { "$ref": "#/$defs/model" },
        "selected_tasks": { "$ref": "#/$defs/count" },
        "observed_wall_tasks": { "$ref": "#/$defs/count" },
        "total_observed_wall_ms": { "anyOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
        "median_observed_wall_ms": { "anyOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
        "p95_observed_wall_ms": { "anyOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
        "provider_token_totals": { "$ref": "#/$defs/tokens" },
        "provider_token_coverage": { "$ref": "#/$defs/coverage" },
        "estimated_cost_tasks": { "$ref": "#/$defs/count" },
        "standard_api_equivalent_usd_nanos": {
          "anyOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "observed_wall_tasks": { "const": 0 } },
            "required": ["observed_wall_tasks"]
          },
          "then": {
            "properties": {
              "total_observed_wall_ms": { "type": "null" },
              "median_observed_wall_ms": { "type": "null" },
              "p95_observed_wall_ms": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "total_observed_wall_ms": { "$ref": "#/$defs/count" },
              "median_observed_wall_ms": { "$ref": "#/$defs/count" },
              "p95_observed_wall_ms": { "$ref": "#/$defs/count" }
            }
          }
        }
      ]
    },
    "verifiedScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "score", "efficiency"],
      "properties": {
        "model": { "$ref": "#/$defs/model" },
        "score": { "$ref": "calibration-score-report-v2.schema.json" },
        "efficiency": { "$ref": "#/$defs/efficiency" }
      }
    },
    "solRate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "input_usd_nanos_per_token",
        "cached_input_usd_nanos_per_token",
        "cache_write_input_usd_nanos_per_token",
        "output_usd_nanos_per_token"
      ],
      "properties": {
        "model": { "const": "gpt-5.6-sol" },
        "input_usd_nanos_per_token": { "const": 5000 },
        "cached_input_usd_nanos_per_token": { "const": 500 },
        "cache_write_input_usd_nanos_per_token": { "const": 6250 },
        "output_usd_nanos_per_token": { "const": 30000 }
      }
    },
    "terraRate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "input_usd_nanos_per_token",
        "cached_input_usd_nanos_per_token",
        "cache_write_input_usd_nanos_per_token",
        "output_usd_nanos_per_token"
      ],
      "properties": {
        "model": { "const": "gpt-5.6-terra" },
        "input_usd_nanos_per_token": { "const": 2000 },
        "cached_input_usd_nanos_per_token": { "const": 200 },
        "cache_write_input_usd_nanos_per_token": { "const": 2500 },
        "output_usd_nanos_per_token": { "const": 12000 }
      }
    },
    "lunaRate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "input_usd_nanos_per_token",
        "cached_input_usd_nanos_per_token",
        "cache_write_input_usd_nanos_per_token",
        "output_usd_nanos_per_token"
      ],
      "properties": {
        "model": { "const": "gpt-5.6-luna" },
        "input_usd_nanos_per_token": { "const": 200 },
        "cached_input_usd_nanos_per_token": { "const": 20 },
        "cache_write_input_usd_nanos_per_token": { "const": 250 },
        "output_usd_nanos_per_token": { "const": 1200 }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "version",
        "as_of",
        "source",
        "currency",
        "processing_tier",
        "rates",
        "formula",
        "hosted_tool_fees_included",
        "limitation"
      ],
      "properties": {
        "method": { "const": "standard_api_equivalent_text_token_estimate" },
        "version": { "const": "aiq.standard-api-equivalent-usd.v1" },
        "as_of": { "const": "2026-08-02" },
        "source": { "const": "https://developers.openai.com/api/docs/pricing" },
        "currency": { "const": "USD" },
        "processing_tier": { "const": "standard" },
        "rates": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "$ref": "#/$defs/solRate" },
            { "$ref": "#/$defs/terraRate" },
            { "$ref": "#/$defs/lunaRate" }
          ],
          "items": false
        },
        "formula": {
          "const": "(input-cached_input-cache_write_input)*input_usd_nanos_per_token + cached_input*cached_input_usd_nanos_per_token + cache_write_input*cache_write_input_usd_nanos_per_token + output*output_usd_nanos_per_token; reasoning is a subset of output and is not added again"
        },
        "hosted_tool_fees_included": { "const": false },
        "limitation": {
          "const": "Standard short-context API-equivalent comparison only. Prompts above 272000 input tokens use 2x input and 1.5x output rates, but aggregate usage cannot identify each request context band; a result above 272000 aggregate input tokens is therefore unpriced. Regional processing uplift and hosted tool fees are excluded. This is not actual subscription spend. Long-context rule: https://developers.openai.com/api/docs/pricing"
        }
      }
    }
  }
}
