{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiq.wiki/schema/leakage-review-v2.schema.json",
  "title": "AIQ independently supplied leakage review v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "task_id",
    "task_version",
    "reviewer_identity",
    "reviewer_task_identity",
    "reviewed_at",
    "source",
    "task_definition_sha256",
    "catalog_entry_sha256",
    "verdict",
    "method",
    "scope",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "aiq.leakage-review.v2" },
    "review_id": { "$ref": "#/$defs/identity" },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "task_version": { "const": "1.1.0" },
    "reviewer_identity": { "$ref": "#/$defs/identity" },
    "reviewer_task_identity": { "$ref": "#/$defs/identity" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "source_tree", "source_manifest_sha256"],
      "properties": {
        "source_commit": { "$ref": "#/$defs/gitIdentity" },
        "source_tree": { "$ref": "#/$defs/gitIdentity" },
        "source_manifest_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "task_definition_sha256": { "$ref": "#/$defs/digest" },
    "catalog_entry_sha256": { "$ref": "#/$defs/digest" },
    "verdict": { "enum": ["approved", "rejected"] },
    "method": { "$ref": "#/$defs/reviewText" },
    "scope": { "$ref": "#/$defs/reviewText" },
    "notes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reviewText" }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/-]+(?![\\s\\S])"
    },
    "gitIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "reviewText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
    }
  }
}
