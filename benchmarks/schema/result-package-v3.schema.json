    "taskResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "result_id",
        "run_id",
        "task_id",
        "task_version",
        "task_hash",
        "model",
        "status",
        "evaluation",
        "task_score",
        "response",
        "response_sha256",
        "evaluator_result_sha256",
        "evaluator_stdout_sha256",
