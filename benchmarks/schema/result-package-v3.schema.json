        "latency",
        "tool_usage",
        "workspace_manifest",
        "provenance"
      ],
      "properties": {
        "schema_version": {
          "const": "aiq.result.v2"
        },
        "result_id": {
          "type": "string",
          "pattern": "^result_[a-f0-9]{64}(?![\\s\\S])"
        },
        "run_id": {
          "$ref": "#/$defs/runId"
        },
        "task_id": {
          "$ref": "#/$defs/taskId"
        },
        "task_version": {
          "const": "1.0.6"
        },
        "task_hash": {
          "$ref": "#/$defs/sha256"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "status": {
          "enum": ["completed", "failed", "unsupported", "unevaluated"]
        },
        "evaluation": {
          "enum": ["correct", "partial", "incorrect", "not_evaluated"]
        },
        "task_score": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ]
        },
        "response": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 64,
              "x-aiq-maxUtf8Bytes": 64
            }
          ]
        },
        "response_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "evaluator_result_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "evaluator_stdout_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "artifacts": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/resultArtifact"
          },
          "x-aiq-uniqueBy": ["kind", "uri"]
        },
        "failure": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/failure"
            }
          ]
        },
        "latency": {
          "$ref": "#/$defs/latency"
        },
        "tool_usage": {
          "$ref": "#/$defs/toolUsage"
        },
        "workspace_manifest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/workspaceManifestArtifact"
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/resultProvenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "response": {
                "type": "string"
              },
              "response_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "evaluator_result_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "failure": {
                "type": "null"
              }
            },
            "oneOf": [
              {
                "properties": {
                  "evaluation": {
                    "const": "correct"
                  },
                  "task_score": {
                    "const": 1
                  }
                }
              },
              {
                "properties": {
                  "evaluation": {
                    "const": "incorrect"
                  },
                  "task_score": {
                    "const": 0
                  }
                }
              },
              {
                "properties": {
                  "evaluation": {
                    "const": "partial"
                  },
                  "task_score": {
                    "type": "number",
