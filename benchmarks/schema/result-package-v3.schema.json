{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiq.wiki/schema/result-package-v3.schema.json",
  "title": "AIQ full result submission package v3",
  "description": "The bounded full-run envelope accepted by the AIQ submission boundary. Local calibration packages are not valid submissions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "idempotency_key",
    "payload_type",
    "content_hash",
    "signer",
    "claimed_trust",
    "payload",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "aiq.result-package.v3"
    },
    "idempotency_key": {
      "$ref": "#/$defs/runId"
    },
    "payload_type": {
      "const": "aiq.run.v3"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "public_key"],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^node_[a-f0-9]{64}(?![\\s\\S])"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        }
      }
    },
    "claimed_trust": {
      "enum": ["trusted", "untrusted"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "schedule_slot",
        "task_set_hash",
        "scoring_version",
        "execution_concurrency",
        "models",
        "started_unix_ms",
        "finished_unix_ms",
        "synthetic",
        "capability_validation",
        "provenance",
        "evaluator_results_artifact",
        "results"
      ],
      "properties": {
        "schema_version": {
          "const": "aiq.run.v3"
        },
        "run_id": {
          "$ref": "#/$defs/runId"
        },
        "schedule_slot": {
          "$ref": "#/$defs/scheduleSlot"
        },
        "task_set_hash": {
          "$ref": "#/$defs/sha256"
        },
        "scoring_version": {
          "const": "1.0.6"
        },
        "execution_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "models": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "prefixItems": [
            {
              "$ref": "#/$defs/solLow"
            },
            {
              "$ref": "#/$defs/solMedium"
            },
            {
              "$ref": "#/$defs/solHigh"
            },
            {
              "$ref": "#/$defs/solXhigh"
            },
            {
              "$ref": "#/$defs/solMax"
            },
            {
              "$ref": "#/$defs/solUltra"
            },
            {
              "$ref": "#/$defs/terraLow"
            },
            {
              "$ref": "#/$defs/terraMedium"
            },
            {
              "$ref": "#/$defs/terraHigh"
            },
            {
              "$ref": "#/$defs/terraXhigh"
            },
            {
              "$ref": "#/$defs/terraMax"
            },
            {
              "$ref": "#/$defs/terraUltra"
            },
            {
              "$ref": "#/$defs/lunaLow"
            },
            {
              "$ref": "#/$defs/lunaMedium"
            },
            {
              "$ref": "#/$defs/lunaHigh"
            },
            {
              "$ref": "#/$defs/lunaXhigh"
            },
            {
              "$ref": "#/$defs/lunaMax"
            }
          ],
          "items": false
        },
        "started_unix_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finished_unix_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "synthetic": {
          "type": "boolean"
        },
        "capability_validation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/capabilityValidationReport"
            }
          ]
        },
        "provenance": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/runProvenance"
            }
          ]
        },
        "evaluator_results_artifact": {
          "$ref": "#/$defs/evaluatorResultsArtifact"
        },
        "results": {
          "type": "array",
          "minItems": 1224,
          "maxItems": 1224,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/taskResult"
          },
          "x-aiq-uniqueTuple": ["task_id", "model.family", "model.reasoning_effort"],
          "x-aiq-distinctCount": {
            "path": "task_id",
            "equals": 72
          }
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}(?![\\s\\S])"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": ["synthetic"]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "capability_validation": {
                "type": "null"
              },
              "provenance": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "payload": {
            "properties": {
              "capability_validation": {
                "$ref": "#/$defs/capabilityValidationReport"
              },
              "provenance": {
                "allOf": [
                  {
                    "$ref": "#/$defs/runProvenance"
                  },
                  {
                    "properties": {
                      "run_class": {
                        "const": "official"
                      }
                    },
                    "required": ["run_class"]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^run_[a-f0-9]{64}(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}(?![\\s\\S]))[a-f0-9]{64}(?![\\s\\S])"
    },
    "evaluatorResultsArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "content_hash", "uri", "bytes"],
      "properties": {
        "kind": {
          "const": "evaluator-results.json"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "uri": {
          "type": "string",
          "pattern": "^aiq-artifact://sha256/[a-f0-9]{64}/evaluator-results\\.json(?![\\s\\S])"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3948544
        }
      }
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+(?![\\s\\S])"
    },
    "taskVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9._-]+(?![\\s\\S])"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "reasoning_effort"],
      "properties": {
        "family": {
          "enum": ["sol", "terra", "luna"]
        },
        "reasoning_effort": {
          "enum": ["low", "medium", "high", "xhigh", "max", "ultra"]
        }
      }
    },
    "solLow": {
      "const": {
        "family": "sol",
        "reasoning_effort": "low"
      }
    },
    "solMedium": {
      "const": {
        "family": "sol",
        "reasoning_effort": "medium"
      }
    },
    "solHigh": {
      "const": {
        "family": "sol",
        "reasoning_effort": "high"
      }
    },
    "solXhigh": {
      "const": {
        "family": "sol",
        "reasoning_effort": "xhigh"
      }
    },
    "solMax": {
      "const": {
        "family": "sol",
        "reasoning_effort": "max"
      }
    },
    "solUltra": {
      "const": {
        "family": "sol",
        "reasoning_effort": "ultra"
      }
    },
    "terraLow": {
      "const": {
        "family": "terra",
        "reasoning_effort": "low"
      }
    },
    "terraMedium": {
      "const": {
        "family": "terra",
        "reasoning_effort": "medium"
      }
    },
    "terraHigh": {
      "const": {
        "family": "terra",
        "reasoning_effort": "high"
      }
    },
    "terraXhigh": {
      "const": {
        "family": "terra",
        "reasoning_effort": "xhigh"
      }
    },
    "terraMax": {
      "const": {
        "family": "terra",
        "reasoning_effort": "max"
      }
    },
    "terraUltra": {
      "const": {
        "family": "terra",
        "reasoning_effort": "ultra"
      }
    },
    "lunaLow": {
      "const": {
        "family": "luna",
        "reasoning_effort": "low"
      }
    },
    "lunaMedium": {
      "const": {
        "family": "luna",
        "reasoning_effort": "medium"
      }
    },
    "lunaHigh": {
      "const": {
        "family": "luna",
        "reasoning_effort": "high"
      }
    },
    "lunaXhigh": {
      "const": {
        "family": "luna",
        "reasoning_effort": "xhigh"
      }
    },
    "lunaMax": {
      "const": {
        "family": "luna",
        "reasoning_effort": "max"
      }
    },
    "scheduleSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_date", "occurrence", "local_time", "timezone"],
      "properties": {
        "local_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
        },
        "occurrence": {
          "enum": ["day", "night"]
        },
        "local_time": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-9]{2}(?![\\s\\S])"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "artifactBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "content_hash", "uri", "bytes"],
      "properties": {
        "kind": {
          "enum": [
            "stdout.jsonl",
            "stderr.txt",
            "final-response.txt",
            "workspace-snapshot.json",
            "workspace-manifest.json",
            "capability-marker.txt"
          ]
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "uri": {
          "type": "string",
          "pattern": "^aiq-artifact://sha256/[a-f0-9]{64}/[A-Za-z0-9._-]+(?![\\s\\S])"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        }
      },
      "x-aiq-uriBinds": ["content_hash", "kind"]
    },
    "preflightArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactBase"
        },
        {
          "properties": {
            "kind": {
              "enum": ["stdout.jsonl", "stderr.txt"]
            }
          },
          "required": ["kind"]
        }
      ]
    },
    "capabilityProbeArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactBase"
        },
        {
          "properties": {
            "kind": {
              "enum": ["stdout.jsonl", "stderr.txt", "capability-marker.txt"]
            }
          },
          "required": ["kind"]
        }
      ]
    },
    "resultArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactBase"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "stdout.jsonl",
                "stderr.txt",
                "final-response.txt",
                "workspace-snapshot.json"
              ]
            }
          },
          "required": ["kind"]
        }
      ]
    },
    "workspaceManifestArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactBase"
        },
        {
          "properties": {
            "kind": {
              "const": "workspace-manifest.json"
            }
          },
          "required": ["kind"]
        }
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message", "exit_code", "retryable"],
      "properties": {
        "kind": {
          "enum": [
            "spawn",
            "timeout",
            "unsupported_model",
            "authentication",
            "subscription_limit",
            "non_zero_exit",
            "capability_unavailable",
            "capability_validation_failed",
            "missing_evaluator",
            "missing_response",
            "evaluator_failure",
            "budget_exceeded",
            "output_truncated",
            "workspace_unavailable",
            "workspace_integrity"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!.*[\"\\\\])[ -~]+(?![\\s\\S])"
        },
        "exit_code": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_ms"],
      "properties": {
        "wall_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "toolUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "total_calls", "by_tool"],
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "total_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "by_tool": {
          "type": "object",
          "maxProperties": 4,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9._-]+(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      },
      "x-aiq-saturatingSum": {
        "source": "by_tool",
        "equals": "total_calls",
        "maximum": 4294967295
      }
    },
    "resultProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "runner_version",
        "codex_version",
        "observed_at",
        "synthetic",
        "local_trust"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^node_[a-f0-9]{64}(?![\\s\\S])"
        },
        "runner_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(?!.*[\"\\\\])[ -~]+(?![\\s\\S])"
        },
        "codex_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[^\"\\\\\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
        },
        "observed_at": {
          "type": "string",
          "pattern": "^(?:synthetic|unix-ms:[0-9]{1,39})(?![\\s\\S])"
        },
        "synthetic": {
          "type": "boolean"
        },
        "local_trust": {
          "enum": ["trusted", "untrusted"]
        }
      }
    },
    "adapterFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "exit_code",
        "stderr",
        "message",
        "stdout_truncated",
        "stderr_truncated",
        "artifacts"
      ],
      "properties": {
        "kind": {
          "enum": [
            "spawn",
            "timeout",
            "unsupported",
            "authentication",
            "usage_limit",
            "non_zero_exit",
            "budget_exceeded",
            "output_truncated",
            "workspace_integrity"
          ]
        },
        "exit_code": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          ]
        },
        "stderr": {
          "type": "string",
          "maxLength": 64,
          "x-aiq-maxUtf8Bytes": 64
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!.*[\"\\\\])[ -~]+(?![\\s\\S])"
        },
        "stdout_truncated": {
          "type": "boolean"
        },
        "stderr_truncated": {
          "type": "boolean"
        },
        "artifacts": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/preflightArtifact"
          }
        }
      }
    },
    "nullableAdapterFailure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/adapterFailure"
        }
      ]
    },
    "capabilityValidationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "node_id",
        "manifest_issues",
        "cli_probe",
        "authentication_probe",
        "models"
      ],
      "properties": {
        "schema_version": {
          "const": "aiq.capability-validation.v3"
        },
        "node_id": {
          "type": "string",
          "pattern": "^node_[a-f0-9]{64}(?![\\s\\S])"
        },
        "manifest_issues": {
          "type": "array",
          "maxItems": 17,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!.*[\"\\\\])[ -~]+(?![\\s\\S])"
          }
        },
        "cli_probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "version", "failure"],
          "properties": {
            "status": {
              "enum": ["available", "unavailable"]
            },
            "version": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[^\"\\\\\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
                }
              ]
            },
            "failure": {
              "$ref": "#/$defs/nullableAdapterFailure"
            }
          }
        },
        "authentication_probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "mode", "failure"],
          "properties": {
            "status": {
              "enum": ["available", "unavailable"]
            },
            "mode": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "const": "chatgpt_subscription"
                }
              ]
            },
            "failure": {
              "$ref": "#/$defs/nullableAdapterFailure"
            }
          }
        },
        "models": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "prefixItems": [
            {
              "$ref": "#/$defs/solLowCapability"
            },
            {
              "$ref": "#/$defs/solMediumCapability"
            },
            {
              "$ref": "#/$defs/solHighCapability"
            },
            {
              "$ref": "#/$defs/solXhighCapability"
            },
            {
              "$ref": "#/$defs/solMaxCapability"
            },
            {
              "$ref": "#/$defs/solUltraCapability"
            },
            {
              "$ref": "#/$defs/terraLowCapability"
            },
            {
              "$ref": "#/$defs/terraMediumCapability"
            },
            {
              "$ref": "#/$defs/terraHighCapability"
            },
            {
              "$ref": "#/$defs/terraXhighCapability"
            },
            {
              "$ref": "#/$defs/terraMaxCapability"
            },
            {
              "$ref": "#/$defs/terraUltraCapability"
            },
            {
              "$ref": "#/$defs/lunaLowCapability"
            },
            {
              "$ref": "#/$defs/lunaMediumCapability"
            },
            {
              "$ref": "#/$defs/lunaHighCapability"
            },
            {
              "$ref": "#/$defs/lunaXhighCapability"
            },
            {
              "$ref": "#/$defs/lunaMaxCapability"
            }
          ],
          "items": false
        }
      }
    },
    "capabilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "status", "reason", "probe"],
      "properties": {
        "model": {
          "$ref": "#/$defs/model"
        },
        "status": {
          "enum": ["available", "unsupported", "unavailable"]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!.*[\"\\\\])[ -~]+(?![\\s\\S])"
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "codex_version",
            "observed_at",
            "result_digest",
            "result_preview",
            "artifacts",
            "evidence_digest",
            "failure"
          ],
          "properties": {
            "status": {
              "enum": ["available", "observed_unsupported", "failed"]
            },
            "codex_version": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[^\"\\\\\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
                }
              ]
            },
            "observed_at": {
              "type": "string",
              "pattern": "^unix-ms:[0-9]{1,39}(?![\\s\\S])"
            },
            "result_digest": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/sha256"
                }
              ]
            },
            "result_preview": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 64,
                  "x-aiq-maxUtf8Bytes": 64
                }
              ]
            },
            "artifacts": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/capabilityProbeArtifact"
              }
            },
            "evidence_digest": {
              "$ref": "#/$defs/sha256"
            },
            "failure": {
