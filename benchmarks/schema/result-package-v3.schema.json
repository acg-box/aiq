                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unevaluated"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evaluation": {
                "const": "not_evaluated"
              },
              "task_score": {
                "type": "null"
              },
              "response": {
                "type": "string"
              },
              "response_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "evaluator_result_sha256": {
                "type": "null"
              },
              "failure": {
                "allOf": [
                  {
                    "$ref": "#/$defs/failure"
                  },
                  {
                    "properties": {
                      "kind": {
                        "const": "missing_evaluator"
                      }
                    },
                    "required": ["kind"]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unsupported"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evaluation": {
                "const": "not_evaluated"
              },
              "task_score": {
                "type": "null"
              },
              "response": {
                "type": "null"
              },
              "response_sha256": {
                "type": "null"
              },
              "evaluator_result_sha256": {
                "type": "null"
              },
              "failure": {
                "allOf": [
                  {
                    "$ref": "#/$defs/failure"
                  },
                  {
                    "properties": {
                      "kind": {
                        "const": "capability_unavailable"
                      }
                    },
                    "required": ["kind"]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evaluation": {
                "const": "not_evaluated"
              },
              "evaluator_result_sha256": {
                "type": "null"
              },
              "failure": {
                "$ref": "#/$defs/failure"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "failure": {
                      "properties": {
                        "kind": {
                          "const": "evaluator_failure"
                        }
                      },
                      "required": ["kind"]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "task_score": {
                      "type": "null"
                    },
                    "response": {
                      "type": "string"
                    },
                    "response_sha256": {
                      "$ref": "#/$defs/sha256"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "response": {
                      "type": "null"
                    },
                    "response_sha256": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "failure": {
                      "properties": {
                        "kind": {
                          "enum": [
                            "timeout",
                            "unsupported_model",
                            "non_zero_exit",
                            "missing_response",
                            "budget_exceeded",
                            "output_truncated"
                          ]
                        }
                      },
                      "required": ["kind"]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "task_score": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "task_score": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "properties": {
                  "failure": {
                    "properties": {
                      "kind": {
                        "enum": [
                          "spawn",
                          "timeout",
                          "unsupported_model",
                          "authentication",
                          "subscription_limit",
                          "non_zero_exit",
                          "capability_validation_failed",
                          "missing_response",
                          "evaluator_failure",
                          "budget_exceeded",
                          "output_truncated",
                          "workspace_unavailable",
                          "workspace_integrity"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": ["status"]
          },
          "else": {
            "properties": {
              "evaluator_result_sha256": {
                "type": "null"
              }
            }
          }
        }
      ],
      "x-aiq-runtimeBindings": [
        "result_id",
        "run_id",
        "task_hash",
        "response_sha256",
        "workspace_manifest",
        "provenance",
        "preflight_status"
      ]
    }
