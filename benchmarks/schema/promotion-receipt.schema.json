{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiq.wiki/schema/promotion-receipt.v1.json",
  "title": "Signed AIQ Core candidate promotion receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signature_domain",
    "signature_encoding",
    "release_identity",
    "candidate_catalog_release_identity_digest",
    "task_metadata_identity_digest",
    "authority_digest",
    "evidence_digest",
    "gate_result_digest",
    "promotion_state",
    "issued_at",
    "signer",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "aiq.promotion-receipt.v1" },
    "signature_domain": { "const": "aiq.promotion-receipt.v1" },
    "signature_encoding": { "const": "aiq.sorted-key-json.v1" },
    "release_identity": { "const": "aiq-core/1.0.2" },
    "candidate_catalog_release_identity_digest": {
      "const": "sha256:45bf2e9d5287fd4f83e46bc3cb5c3ccb8778756465e81bfd567d111480eefc4b"
    },
    "task_metadata_identity_digest": {
      "const": "sha256:2c5efe162b49e710e6e52b0f3a4e33d1127d0dd54d4f15694f88911bcb7fc937"
    },
    "authority_digest": { "$ref": "#/$defs/digest" },
    "evidence_digest": { "$ref": "#/$defs/digest" },
    "gate_result_digest": { "$ref": "#/$defs/digest" },
    "promotion_state": { "const": "released" },
    "issued_at": { "type": "string", "format": "date-time" },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm"],
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*(?![\\s\\S])"
        },
        "algorithm": { "const": "ed25519" }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==(?![\\s\\S])"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}(?![\\s\\S]))[a-f0-9]{64}(?![\\s\\S])"
    }
  }
}
