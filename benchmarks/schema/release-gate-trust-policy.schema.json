{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiq.wiki/schema/release-gate-trust.v1.json",
  "title": "AIQ Core release-gate trust policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_identity", "authority_signers", "promotion_signers"],
  "properties": {
    "schema_version": { "const": "aiq.release-gate-trust.v1" },
    "release_identity": { "const": "aiq-core/1.0.2" },
    "authority_signers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/trustedSigner" }
    },
    "promotion_signers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/trustedSigner" }
    }
  },
  "$defs": {
    "trustedSigner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "public_key_spki_base64"],
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*(?![\\s\\S])"
        },
        "algorithm": { "const": "ed25519" },
        "public_key_spki_base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}(?![\\s\\S])"
        }
      }
    }
  }
}
