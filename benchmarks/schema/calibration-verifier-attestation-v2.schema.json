{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiq.wiki/schema/calibration-verifier-attestation-v2.schema.json",
  "title": "AIQ calibration verifier attestation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signature_algorithm",
    "signature_version",
    "run_id",
    "package_sha256",
    "content_hash",
    "stage_digest",
    "runner",
    "verifier",
    "classification",
    "run_class",
    "official_eligible",
    "ranking_eligible",
    "trust",
    "task_set_hash",
    "terminal_attempt_lineage_digest",
    "task_selection_digest",
    "model_selection_digest",
    "score_reports_digest",
    "telemetry_digest",
    "capability_validation_digest",
    "scoring_version",
    "execution_concurrency",
    "observed_unix_ms",
    "replay_status",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "aiq.calibration-verifier-attestation.v2" },
    "signature_algorithm": { "const": "ed25519" },
    "signature_version": { "const": "aiq.ed25519-jcs.v1" },
    "run_id": { "type": "string", "pattern": "^run_[a-f0-9]{64}(?![\\s\\S])" },
    "package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])" },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])" },
    "stage_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])" },
    "runner": { "$ref": "result-package-v4.schema.json#/properties/signer" },
    "verifier": { "$ref": "result-package-v4.schema.json#/properties/signer" },
    "classification": { "const": "local_calibration_non_official" },
    "run_class": { "const": "calibration" },
    "official_eligible": { "const": false },
    "ranking_eligible": { "const": false },
    "trust": { "const": "untrusted" },
    "task_set_hash": { "$ref": "#/$defs/digest" },
    "terminal_attempt_lineage_digest": { "$ref": "#/$defs/digest" },
    "task_selection_digest": { "$ref": "#/$defs/digest" },
    "model_selection_digest": { "$ref": "#/$defs/digest" },
    "score_reports_digest": { "$ref": "#/$defs/digest" },
    "telemetry_digest": { "$ref": "#/$defs/digest" },
    "capability_validation_digest": { "$ref": "#/$defs/digest" },
    "scoring_version": { "const": "1.0.7" },
    "execution_concurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
    "observed_unix_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "replay_status": { "const": "evaluator_replayed" },
    "signature": { "type": "string", "pattern": "^[a-f0-9]{128}(?![\\s\\S])" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}(?![\\s\\S]))[a-f0-9]{64}(?![\\s\\S])"
    }
  }
}
