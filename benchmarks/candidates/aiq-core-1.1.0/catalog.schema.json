              "type": "object",
              "additionalProperties": false,
              "required": [
                "verdict",
                "record_sha256",
                "task_definition_sha256",
                "catalog_entry_sha256",
                "issue_codes"
              ],
              "properties": {
                "verdict": {
                  "enum": [
                    "approved",
                    "rejected"
