{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiq.wiki/schema/aiq-core/1.1.0/catalog.v1.json",
  "title": "AIQ public benchmark catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_set_id",
    "task_set_version",
    "scoring_version",
    "title",
    "status",
    "generated_from",
    "task_metadata_identity",
    "catalog_release_identity",
    "content_policy",
    "distribution",
    "tasks",
    "candidate_identity",
    "candidate_state"
  ],
  "properties": {
    "schema_version": {
      "const": "aiq.catalog.v2"
    },
    "task_set_id": {
      "const": "aiq-core"
    },
    "task_set_version": {
      "const": "1.1.0"
    },
    "scoring_version": {
      "const": "1.0.6"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "frozen_candidate"
    },
    "generated_from": {
      "const": "scripts/candidates/aiq-core-1.1.0/generate-benchmark-catalog.ts"
    },
    "task_metadata_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "digest", "scope"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "aiq.sorted-key-json.v1"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:(?!0{64}(?![\\s\\S]))[0-9a-f]{64}(?![\\s\\S])"
        },
        "scope": {
          "const": "ordered_full_task_metadata"
        }
      }
    },
    "catalog_release_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_identity",
        "scoring_version",
        "task_metadata_identity",
        "algorithm",
        "canonicalization",
        "digest",
        "scope"
      ],
      "properties": {
        "release_identity": {
          "const": "aiq-core/1.1.0-candidate.2"
        },
        "scoring_version": {
          "const": "1.0.6"
        },
        "task_metadata_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "canonicalization", "digest", "scope"],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "canonicalization": {
              "const": "aiq.sorted-key-json.v1"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:(?!0{64}(?![\\s\\S]))[0-9a-f]{64}(?![\\s\\S])"
            },
            "scope": {
              "const": "ordered_full_task_metadata"
            }
          }
        },
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "aiq.sorted-key-json.v1"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "scope": {
          "const": "candidate_identity_scoring_version_and_ordered_task_metadata_identity"
        }
      }
    },
    "content_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_repository", "controlled_source"],
      "properties": {
        "public_repository": {
          "type": "string",
          "minLength": 1
        },
        "controlled_source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "domains", "difficulties", "domain_difficulty", "difficulty_role"],
      "properties": {
        "total": {
          "const": 72
        },
        "domains": {
          "type": "object"
        },
        "difficulties": {
          "type": "object"
        },
        "domain_difficulty": {
          "type": "object"
        },
        "difficulty_role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 72,
      "maxItems": 72,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "candidate_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "task_metadata_digest"],
      "properties": {
        "candidate_id": {
          "const": "aiq-core/1.1.0-candidate.2"
        },
        "task_metadata_digest": {
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
          "type": "string"
        }
      }
    },
    "candidate_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_state",
        "predecessor_task_set_version",
        "predecessor_candidate",
        "decision_record",
        "semantic_decision_counts",
        "issue_closure_counts",
        "private_fixture_mapping_reconciled",
        "private_tasks_authored",
        "predecessor_review_status",
        "independent_review_status",
        "seal_status",
        "calibration_status",
        "qualification_status",
        "release_status",
        "activation_status",
        "deployment_status",
        "production_acceptance_status",
        "active",
        "production_publishable",
        "next_required_actions"
      ],
      "properties": {
        "identity_state": {
          "const": "frozen_for_independent_review"
        },
        "predecessor_task_set_version": {
          "const": "1.0.7"
        },
        "predecessor_candidate": {
          "const": {
            "candidate_id": "aiq-core/1.1.0-candidate.1",
            "disposition": "rejected_nonsealable_superseded_evidence",
            "merge_commit": "c3358404e247be575929e65b8c557b8bfa831889",
            "change_commit": "1db9431ef3696c2f377ac741aad70094803d9987",
            "source_tree": "ad6e528adfb3f22597eaa9f32b03bc71e57e34ad",
            "aggregate_review_sha256": "sha256:4420248576150192a516be9ffe9c43a25112a58baf7c4a5519b0db6bca1dac45",
            "catalog_sha256": "sha256:a8e4f6f0f0effc1fddbfe320b2efaeaf20b9121f723a1abbeca4c7fc513563c7",
            "accepted_tasks": 20,
            "rejected_tasks": 52,
            "semantic_retention_rule": "only_review_approved_tasks_may_retain_candidate_1_semantics"
          }
        },
        "decision_record": {
          "const": "benchmarks/candidates/aiq-core-1.1.0/design-decisions.json"
        },
        "semantic_decision_counts": {
          "const": {
            "retained": 20,
            "revised": 52
          }
        },
        "issue_closure_counts": {
          "const": {
            "ACCEPTANCE_SEMANTICS_INVALID": 4,
            "BEHAVIORAL_COVERAGE_GAP": 5,
            "CROSS_TASK_CONSTRUCT_DUPLICATION": 4,
            "HIDDEN_OUTPUT_SCHEMA": 36,
            "KEYWORD_ONLY_EVALUATOR": 6,
            "PUBLIC_PRIVATE_CONSTRUCT_MISMATCH": 25,
            "PUBLIC_SEMANTIC_CONTAMINATION": 3,
            "TOOL_EVIDENCE_UNBOUND": 7
          }
        },
        "private_fixture_mapping_reconciled": {
          "const": true
        },
        "private_tasks_authored": {
          "const": true
        },
        "predecessor_review_status": {
          "const": "complete_rejected_nonsealable"
        },
        "independent_review_status": {
          "const": "pending"
        },
        "seal_status": {
          "const": "pending"
        },
        "calibration_status": {
          "const": "pending"
        },
        "qualification_status": {
          "const": "pending"
        },
        "release_status": {
          "const": "pending"
        },
        "activation_status": {
          "const": "pending"
        },
        "deployment_status": {
          "const": "pending"
        },
        "production_acceptance_status": {
          "const": "pending"
        },
        "active": {
          "const": false
        },
        "production_publishable": {
          "const": false
        },
        "next_required_actions": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 40
          }
        }
      }
    }
  },
  "$defs": {
    "scoringComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "weight_basis_points", "criterion"],
      "properties": {
        "component_id": {
          "type": "string"
        },
        "weight_basis_points": {
          "type": "integer",
          "minimum": 1
        },
        "criterion": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_version",
        "title",
        "domain",
        "difficulty",
        "summary",
        "design_revision",
        "input_contract",
        "cluster_id",
        "allowed_tools",
        "budget",
        "evaluator",
        "tags",
        "visibility",
        "provenance",
        "leakage_review"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+-[0-9]{2}(?![\\s\\S])"
        },
        "task_version": {
          "const": "1.1.0"
        },
        "title": {
          "type": "string",
          "minLength": 12
        },
        "domain": {
          "enum": [
            "coding",
            "debugging",
            "repository_understanding",
            "data_processing",
            "retrieval_verification",
            "documentation_communication",
            "planning_execution",
            "tool_use",
            "instruction_following",
            "reliability_recovery"
          ]
        },
        "difficulty": {
          "enum": ["easy", "medium", "hard"]
        },
        "summary": {
          "type": "string",
          "minLength": 30
        },
        "design_revision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supersedes_task_version",
            "supersedes_candidate_id",
            "decision",
            "decision_record",
            "kind",
            "objective",
            "task_specific_delta",
            "candidate_1_review",
            "candidate_2_contract",
            "controlled_corpus_requirements"
          ],
          "properties": {
            "supersedes_task_version": {
              "const": "1.0.7"
            },
            "supersedes_candidate_id": {
              "const": "aiq-core/1.1.0-candidate.1"
            },
            "decision": {
              "enum": ["retained", "revised"]
            },
            "decision_record": {
              "const": "benchmarks/candidates/aiq-core-1.1.0/design-decisions.json"
            },
            "kind": {
              "const": "frozen_candidate_authoring"
            },
            "objective": {
              "type": "string",
              "minLength": 80
            },
            "task_specific_delta": {
              "type": "string",
              "minLength": 160
            },
            "candidate_1_review": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verdict",
                "record_sha256",
                "notes_sha256",
                "task_definition_sha256",
                "catalog_entry_sha256",
                "issue_codes"
              ],
              "properties": {
                "verdict": {
                  "enum": ["approved", "rejected"]
                },
                "record_sha256": {
                  "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
                  "type": "string"
                },
                "notes_sha256": {
                  "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
                  "type": "string"
                },
                "task_definition_sha256": {
                  "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
                  "type": "string"
                },
                "catalog_entry_sha256": {
                  "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
                  "type": "string"
                },
                "issue_codes": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "ACCEPTANCE_SEMANTICS_INVALID",
                      "BEHAVIORAL_COVERAGE_GAP",
                      "CROSS_TASK_CONSTRUCT_DUPLICATION",
                      "HIDDEN_OUTPUT_SCHEMA",
                      "KEYWORD_ONLY_EVALUATOR",
                      "PUBLIC_PRIVATE_CONSTRUCT_MISMATCH",
                      "PUBLIC_SEMANTIC_CONTAMINATION",
                      "TOOL_EVIDENCE_UNBOUND"
                    ]
                  }
                }
              }
            },
            "candidate_2_contract": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "construct_id",
                "response_contract",
                "fixture_applicability",
                "mechanism_classes",
                "falsifiers",
                "coverage_claims"
              ],
              "properties": {
                "construct_id": {
                  "type": "string",
                  "minLength": 12,
                  "maxLength": 128
                },
                "response_contract": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "shape_kind",
                    "transport",
                    "locations",
                    "required_fields",
                    "optional_fields",
                    "field_types",
                    "field_semantics"
                  ],
                  "properties": {
                    "shape_kind": {
                      "type": "string",
                      "minLength": 4
                    },
                    "transport": {
                      "enum": ["final_response", "workspace"]
                    },
                    "locations": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$"
                      }
                    },
                    "required_fields": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "optional_fields": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "field_types": {
                      "type": "object",
                      "minProperties": 1,
                      "additionalProperties": {
                        "enum": [
                          "array",
                          "artifact",
                          "boolean",
                          "module",
                          "null",
                          "number",
                          "object",
                          "string"
                        ]
                      }
                    },
                    "field_semantics": {
                      "type": "object",
                      "minProperties": 1,
                      "additionalProperties": {
                        "type": "string",
                        "minLength": 20
                      }
                    }
                  }
                },
                "fixture_applicability": {
                  "const": {
                    "gold": "required",
                    "alternate_correct": "required",
                    "partial": "required",
                    "adversarial_format": "required",
                    "empty": "required",
                    "timeout": "not_applicable"
                  }
                },
                "mechanism_classes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 8
                  }
                },
                "falsifiers": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 8
                  }
                },
                "coverage_claims": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 20
                  }
                }
              }
            },
            "controlled_corpus_requirements": {
              "type": "array",
              "minItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 40
              }
            }
          }
        },
        "input_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fixture_profile", "content_handle"],
          "properties": {
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"
            },
            "fixture_profile": {
              "type": "string",
              "pattern": "^aiq-fixture://[a-z0-9-]+-[0-9]{2}/v3(?![\\s\\S])"
            },
            "content_handle": {
              "type": "string",
              "pattern": "^aiq-controlled-task://aiq-core/1\\.1\\.0/[a-z0-9-]+-[0-9]{2}(?![\\s\\S])"
            }
          }
        },
        "cluster_id": {
          "type": "string",
          "pattern": "^[a-z_]+-cluster-[0-9]{2}(?![\\s\\S])"
        },
        "allowed_tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "filesystem_read",
              "filesystem_write",
              "web_search",
              "command_execution"
            ]
          },
          "not": {
            "allOf": [
              {
                "type": "array",
                "contains": {
                  "const": "none"
                }
              },
              {
                "type": "array",
                "minItems": 2
              }
            ]
          },
          "allOf": [
            {
              "if": {
                "type": "array",
                "contains": {
                  "const": "command_execution"
                }
              },
              "then": {
                "type": "array",
                "contains": {
                  "enum": ["filesystem_read", "filesystem_write"]
                }
              }
            }
          ]
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wall_seconds", "max_steps", "max_tool_calls"],
          "properties": {
            "wall_seconds": {
              "type": "null"
            },
            "max_steps": {
              "type": "null"
            },
            "max_tool_calls": {
              "type": "null"
            }
          }
        },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "scorer_version",
            "execution_protocol",
            "binding_requirement",
            "deterministic",
            "partial_credit",
            "pass_conditions",
            "scoring_contract",
            "acceptance_fixture_commitments"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"
            },
            "scorer_version": {
              "const": "1.0.6"
            },
            "execution_protocol": {
              "const": "aiq.evaluator-protocol.v1"
            },
            "binding_requirement": {
              "const": "controlled_hidden_task_required"
            },
            "deterministic": {
              "const": true
            },
            "partial_credit": {
              "type": "boolean"
            },
            "pass_conditions": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 8
              }
            },
            "scoring_contract": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "aggregation",
                "check_scoring",
                "check_weighting",
                "weight_source",
                "formula",
                "denominator_requirement",
                "hard_gate_definition",
                "hard_gate_rule",
                "zero_weight_rule",
                "positive_weight_gate_rule",
                "evaluator_error_policy",
                "attributable_runtime_failure_policy",
                "outcome_rule",
                "rounding",
                "score_range",
                "maximum_checks_per_result",
                "public_criteria_role",
                "verification"
              ],
              "properties": {
                "aggregation": {
                  "const": "configured_weighted_binary_check_fraction_with_hard_gates"
                },
                "check_scoring": {
                  "const": "binary"
                },
                "check_weighting": {
                  "const": "nonnegative_integer_weight_per_committed_check"
                },
                "weight_source": {
                  "const": "private_content_addressed_evaluator_configuration"
                },
                "formula": {
                  "const": "hard_gate_or_structural_failure ? 0 : sum(weight_i * passed_i) / sum(weight_i)"
                },
                "denominator_requirement": {
                  "const": "sum_of_positive_check_weights_greater_than_zero"
                },
                "hard_gate_definition": {
                  "const": "hard_gate_true_or_check_type_workspace_policy"
                },
                "hard_gate_rule": {
                  "const": "any_failed_committed_hard_gate_or_structural_failure_sets_score_to_zero"
                },
                "zero_weight_rule": {
                  "const": "only_committed_hard_gates_may_have_zero_weight"
                },
                "positive_weight_gate_rule": {
                  "const": "positive_weight_hard_gate_also_participates_in_weighted_fraction_when_all_hard_gates_pass"
                },
                "evaluator_error_policy": {
                  "const": "unscored_invalid_evidence"
                },
                "attributable_runtime_failure_policy": {
                  "const": "task_score_null_excluded_from_semantic_scoring"
                },
                "outcome_rule": {
                  "const": {
                    "correct": "score_equals_one",
                    "partial": "score_strictly_between_zero_and_one",
                    "incorrect": "score_equals_zero"
                  }
                },
                "rounding": {
                  "const": "no_evaluator_rounding_exact_replay"
                },
                "score_range": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "const": 0
                    },
                    {
                      "const": 1
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                },
                "maximum_checks_per_result": {
                  "const": 16
                },
                "public_criteria_role": {
                  "const": "coverage_summary_not_weight_partition"
                },
                "verification": {
                  "const": "committed_configuration_and_result_checks_are_content_addressed_and_replayed"
                }
              }
            },
            "acceptance_fixture_commitments": {
              "$ref": "#/$defs/acceptanceFixtureCommitments"
            }
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"
          }
        },
        "visibility": {
          "const": "hidden"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "owner",
            "recorded_date",
            "predecessor_task_version",
            "predecessor_candidate_id",
            "source",
            "decision_record"
          ],
          "properties": {
            "origin": {
              "const": "candidate_1_review_remediation_authoring"
            },
            "owner": {
              "const": "AIQ benchmark maintainers"
            },
            "recorded_date": {
              "const": "2026-08-28"
            },
            "predecessor_task_version": {
              "const": "1.0.7"
            },
            "predecessor_candidate_id": {
              "const": "aiq-core/1.1.0-candidate.1"
            },
            "source": {
              "const": "scripts/candidates/aiq-core-1.1.0/generate-benchmark-catalog.ts"
            },
            "decision_record": {
              "const": "benchmarks/candidates/aiq-core-1.1.0/design-decisions.json"
            }
          }
        },
        "leakage_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "owner", "review_requirement", "notes"],
          "properties": {
            "status": {
              "const": "public_design_versioned_private_content_required"
            },
            "owner": {
              "const": "AIQ benchmark maintainers"
            },
            "review_requirement": {
              "const": "private_corpus_tests_and_catalog_binding_required"
            },
            "notes": {
              "type": "string",
              "minLength": 80
            }
          }
        }
      }
    },
    "acceptanceFixtureCommitments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gold",
        "alternate_correct",
        "partial",
        "adversarial_format",
        "empty",
        "timeout"
      ],
      "properties": {
        "gold": {
          "$ref": "#/$defs/acceptanceFixtureCommitment"
        },
        "alternate_correct": {
          "$ref": "#/$defs/acceptanceFixtureCommitment"
        },
        "partial": {
          "$ref": "#/$defs/acceptanceFixtureCommitment"
        },
        "adversarial_format": {
          "description": "Combined adversarial-content and output-format-attack fixture.",
          "$ref": "#/$defs/acceptanceFixtureCommitment"
        },
        "empty": {
          "$ref": "#/$defs/acceptanceFixtureCommitment"
        },
        "timeout": {
          "$ref": "#/$defs/acceptanceFixtureCommitment"
        }
      }
    },
    "acceptanceFixtureCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "handle"],
      "properties": {
        "applicability": {
          "enum": ["required", "not_applicable"]
        },
        "handle": {
          "type": ["string", "null"],
          "pattern": "^aiq-acceptance://[a-z0-9-]+-[0-9]{2}/v(?:2|3|4|5)/(?:gold|alternate-correct|partial|adversarial-format|empty|timeout)(?![\\s\\S])"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "required"
              }
            }
          },
          "else": {
            "properties": {
              "handle": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "handle": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
