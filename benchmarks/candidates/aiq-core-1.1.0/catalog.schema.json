                          }
                        },
                        "additional_fields": {
                          "const": "forbidden"
                        },
                        "key_order": {
                          "const": "not_significant"
                        },
                        "predecessor_undisclosed_fields": {
                          "const": []
                        },
                        "required_invocations": {
                          "const": 1
                        }
                      }
                    }
                  ]
                },
                "fixture_applicability": {
                  "const": {
                    "gold": "required",
                    "alternate_correct": "required",
                    "partial": "required",
                    "adversarial_format": "required",
                    "empty": "required",
                    "timeout": "not_applicable"
                  }
                },
                "mechanism_classes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 8
                  }
                },
                "falsifiers": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 8
                  }
                },
                "coverage_claims": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 20
                  }
                }
              }
            },
            "controlled_corpus_requirements": {
              "type": "array",
              "minItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 40
              }
            }
          }
        },
        "input_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "fixture_profile",
            "content_handle"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"
            },
            "fixture_profile": {
              "type": "string",
              "pattern": "^aiq-fixture://[a-z0-9-]+-[0-9]{2}/v4(?![\\s\\S])"
            },
            "content_handle": {
              "type": "string",
              "pattern": "^aiq-controlled-task://aiq-core/1\\.1\\.0/[a-z0-9-]+-[0-9]{2}(?![\\s\\S])"
            }
          }
        },
        "cluster_id": {
          "type": "string",
          "pattern": "^[a-z_]+-cluster-[0-9]{2}(?![\\s\\S])"
        },
        "allowed_tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "filesystem_read",
              "filesystem_write",
              "web_search",
              "command_execution"
            ]
          },
          "not": {
            "allOf": [
              {
                "type": "array",
                "contains": {
                  "const": "none"
                }
              },
              {
                "type": "array",
                "minItems": 2
              }
            ]
          },
          "allOf": [
            {
              "if": {
                "type": "array",
                "contains": {
                  "const": "command_execution"
                }
              },
              "then": {
                "type": "array",
                "contains": {
                  "enum": [
                    "filesystem_read",
                    "filesystem_write"
                  ]
                }
              }
            }
          ]
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wall_seconds",
            "max_steps",
            "max_tool_calls"
          ],
          "properties": {
            "wall_seconds": {
              "type": "null"
            },
            "max_steps": {
              "type": "null"
            },
            "max_tool_calls": {
              "type": "null"
            }
          }
        },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "scorer_version",
            "execution_protocol",
            "binding_requirement",
            "deterministic",
            "partial_credit",
            "pass_conditions",
            "scoring_contract",
            "acceptance_fixture_commitments"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"
            },
            "scorer_version": {
              "const": "1.0.6"
            },
            "execution_protocol": {
              "const": "aiq.evaluator-protocol.v1"
            },
            "binding_requirement": {
              "const": "controlled_hidden_task_required"
            },
            "deterministic": {
              "const": true
            },
            "partial_credit": {
              "type": "boolean"
            },
            "pass_conditions": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 8
              }
            },
            "scoring_contract": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "aggregation",
                "check_scoring",
                "check_weighting",
                "weight_source",
                "formula",
                "denominator_requirement",
                "hard_gate_definition",
                "hard_gate_rule",
                "zero_weight_rule",
                "positive_weight_gate_rule",
                "evaluator_error_policy",
                "attributable_runtime_failure_policy",
                "outcome_rule",
                "rounding",
                "score_range",
                "maximum_checks_per_result",
                "public_criteria_role",
                "verification"
              ],
              "properties": {
                "aggregation": {
                  "const": "configured_weighted_binary_check_fraction_with_hard_gates"
                },
                "check_scoring": {
                  "const": "binary"
                },
                "check_weighting": {
                  "const": "nonnegative_integer_weight_per_committed_check"
                },
                "weight_source": {
                  "const": "private_content_addressed_evaluator_configuration"
                },
                "formula": {
                  "const": "hard_gate_or_structural_failure ? 0 : sum(weight_i * passed_i) / sum(weight_i)"
                },
                "denominator_requirement": {
                  "const": "sum_of_positive_check_weights_greater_than_zero"
                },
                "hard_gate_definition": {
                  "const": "hard_gate_true_or_check_type_workspace_policy"
                },
                "hard_gate_rule": {
                  "const": "any_failed_committed_hard_gate_or_structural_failure_sets_score_to_zero"
                },
                "zero_weight_rule": {
                  "const": "only_committed_hard_gates_may_have_zero_weight"
                },
                "positive_weight_gate_rule": {
                  "const": "positive_weight_hard_gate_also_participates_in_weighted_fraction_when_all_hard_gates_pass"
                },
                "evaluator_error_policy": {
                  "const": "unscored_invalid_evidence"
                },
                "attributable_runtime_failure_policy": {
                  "const": "task_score_null_excluded_from_semantic_scoring"
                },
                "outcome_rule": {
                  "const": {
                    "correct": "score_equals_one",
                    "partial": "score_strictly_between_zero_and_one",
                    "incorrect": "score_equals_zero"
                  }
                },
                "rounding": {
                  "const": "no_evaluator_rounding_exact_replay"
                },
                "score_range": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "const": 0
                    },
                    {
                      "const": 1
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                },
                "maximum_checks_per_result": {
                  "const": 16
                },
                "public_criteria_role": {
                  "const": "coverage_summary_not_weight_partition"
                },
                "verification": {
                  "const": "committed_configuration_and_result_checks_are_content_addressed_and_replayed"
                }
              }
            },
            "acceptance_fixture_commitments": {
              "$ref": "#/$defs/acceptanceFixtureCommitments"
            }
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"
          }
        },
        "visibility": {
          "const": "hidden"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "owner",
            "recorded_date",
            "predecessor_task_version",
            "predecessor_candidate_id",
            "source",
            "decision_record"
          ],
          "properties": {
            "origin": {
              "const": "candidate_3_review_remediation_authoring"
            },
            "owner": {
              "const": "AIQ benchmark maintainers"
            },
            "recorded_date": {
              "const": "2026-08-28"
            },
            "predecessor_task_version": {
              "const": "1.1.0"
            },
            "predecessor_candidate_id": {
              "const": "aiq-core/1.1.0-candidate.3"
            },
            "source": {
              "const": "scripts/candidates/aiq-core-1.1.0/generate-benchmark-catalog.ts"
            },
            "decision_record": {
              "const": "benchmarks/candidates/aiq-core-1.1.0/design-decisions.json"
            }
          }
        },
        "leakage_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "owner",
            "review_requirement",
            "notes"
          ],
          "properties": {
            "status": {
              "const": "public_design_versioned_private_content_required"
            },
            "owner": {
              "const": "AIQ benchmark maintainers"
            },
            "review_requirement": {
              "const": "private_corpus_tests_and_catalog_binding_required"
            },
            "notes": {
              "type": "string",
              "minLength": 80
            }
          }
        }
      }
    },
    "acceptanceFixtureCommitments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gold",
        "alternate_correct",
        "partial",
        "adversarial_format",
        "empty",
        "timeout"
      ],
      "properties": {
        "gold": {
          "$ref": "#/$defs/acceptanceFixtureCommitment"
        },
        "alternate_correct": {
          "$ref": "#/$defs/acceptanceFixtureCommitment"
        },
        "partial": {
          "$ref": "#/$defs/acceptanceFixtureCommitment"
        },
        "adversarial_format": {
          "description": "Combined adversarial-content and output-format-attack fixture.",
          "$ref": "#/$defs/acceptanceFixtureCommitment"
        },
        "empty": {
          "$ref": "#/$defs/acceptanceFixtureCommitment"
        },
        "timeout": {
          "$ref": "#/$defs/acceptanceFixtureCommitment"
        }
      }
    },
    "acceptanceFixtureCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "handle"
      ],
      "properties": {
        "applicability": {
          "enum": [
            "required",
            "not_applicable"
          ]
        },
        "handle": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^aiq-acceptance://[a-z0-9-]+-[0-9]{2}/v(?:2|3|4|5|6)/(?:gold|alternate-correct|partial|adversarial-format|empty|timeout)(?![\\s\\S])"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "required"
              }
            }
          },
          "else": {
            "properties": {
              "handle": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "handle": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
