  "$defs": {
    "scoringComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "weight_basis_points",
        "criterion"
      ],
      "properties": {
        "component_id": {
          "type": "string"
        },
        "weight_basis_points": {
          "type": "integer",
          "minimum": 1
        },
        "criterion": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_version",
        "title",
        "domain",
        "difficulty",
        "summary",
        "design_revision",
        "input_contract",
        "cluster_id",
        "allowed_tools",
        "budget",
        "evaluator",
        "tags",
        "visibility",
        "provenance",
        "leakage_review"
