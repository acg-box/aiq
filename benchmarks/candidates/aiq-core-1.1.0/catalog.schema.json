                "record_sha256": {
                  "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
                  "type": "string"
                },
                "task_definition_sha256": {
                  "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
                  "type": "string"
                },
                "catalog_entry_sha256": {
