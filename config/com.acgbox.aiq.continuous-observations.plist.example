<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.acgbox.aiq.continuous-observations</string>
  <key>ProgramArguments</key>
  <array>
    <string>/absolute/private/path/to/protected-aiq-launcher</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>5</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/absolute/private/path/to/scheduler.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/absolute/private/path/to/scheduler.stderr.log</string>
</dict>
</plist>
