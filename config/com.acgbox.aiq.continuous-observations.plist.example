<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.acgbox.aiq.continuous-observations</string>
  <key>ProgramArguments</key>
  <!-- launchd invokes the pinned AIQ application directly. AIQ owns unattended
       provider login, exact secret delivery, overlap, and child isolation. -->
  <array>
    <string>/absolute/immutable/path/to/aiq</string>
    <string>run</string>
    <string>--config</string>
    <string>/absolute/private/path/to/continuous-observation.json</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/absolute/service/user/home</string>
    <key>LOGNAME</key>
    <string>service-user</string>
    <key>PATH</key>
    <string>/nix/store/replace-with-pinned-git/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>USER</key>
    <string>service-user</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <!-- Requires the host time zone to be America/New_York. These events cover
       both EST and EDT and stay inside the two-hour UTC dispatch grace. -->
  <array>
    <dict>
      <key>Hour</key>
      <integer>11</integer>
      <key>Minute</key>
      <integer>5</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>11</integer>
      <key>Minute</key>
      <integer>35</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>23</integer>
      <key>Minute</key>
      <integer>5</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>23</integer>
      <key>Minute</key>
      <integer>35</integer>
    </dict>
  </array>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>AbandonProcessGroup</key>
  <!-- Keep same-PGID cleanup enabled. The aiq internal session supervisor owns
       runner-created model and evaluator groups that leave the launchd PGID. -->
  <false/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>/absolute/private/path/to/scheduler.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/absolute/private/path/to/scheduler.stderr.log</string>
</dict>
</plist>
