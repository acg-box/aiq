FROM debian:bookworm-slim@sha256:9b67294679b30e5d6ab257b40594feeb4a4b81f7fcf4131f4decf0d6a212a9b0
ARG DEBIAN_FRONTEND=noninteractive
ARG SNAPSHOT=20260714T000000Z
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.source="https://github.com/acg-box/aiq" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.licenses="GPL-3.0-only"
RUN printf '%s\n' "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${SNAPSHOT} bookworm main" > /etc/apt/sources.list \
 && rm -f /etc/apt/sources.list.d/debian.sources \
 && apt-get -o Acquire::Check-Valid-Until=false update \
 && apt-get install --yes --no-install-recommends bubblewrap=0.8.0-2+deb12u1 ca-certificates=20230311+deb12u1 curl=7.88.1-10+deb12u15 \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 aiq && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /codex-home --shell /usr/sbin/nologin aiq \
 && install -d -o root -g root -m 0755 /run/secrets /etc/codex
COPY --chown=0:0 --chmod=0444 config/codex-requirements.example.toml /etc/codex/requirements.toml
COPY --chown=0:0 --chmod=0555 deploy/candidate-runtime/runner-entrypoint.sh /usr/local/bin/aiq-candidate-entrypoint
COPY --chown=0:0 --chmod=0555 deploy/candidate-runtime/canary.sh /usr/local/bin/aiq-candidate-canary
USER 10001:10001
WORKDIR /candidate/execution
ENTRYPOINT ["/usr/local/bin/aiq-candidate-entrypoint"]
CMD ["hold"]
