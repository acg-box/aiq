FROM rust:1.97.1-bookworm@sha256:77fac8b98f9f46062bb680b6d25d5bcaabfc400143952ebc572e924bcbedc3fa AS build

WORKDIR /source

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY apps/aiq-runner/Cargo.toml apps/aiq-runner/Cargo.toml
COPY apps/aiq-verifier/Cargo.toml apps/aiq-verifier/Cargo.toml
COPY apps/aiq-runner apps/aiq-runner
COPY apps/aiq-verifier apps/aiq-verifier
COPY benchmarks benchmarks
COPY config config
COPY scripts/candidates/aiq-core-1.0.2 scripts/candidates/aiq-core-1.0.2

RUN cargo build --locked --release --package aiq-runner --package aiq-verifier
RUN /source/target/release/aiq-runner --version >/dev/null \
 && /source/target/release/aiq-verifier --version >/dev/null

FROM scratch AS binaries

COPY --from=build /source/target/release/aiq-runner /aiq-runner
COPY --from=build /source/target/release/aiq-verifier /aiq-verifier
