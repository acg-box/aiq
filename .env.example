# Browser-safe, read-only Supabase values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Vercel gateway values. Do not prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
AIQ_RUNNER_SUBMISSION_TOKEN=
# Canonical private Storage bucket for exact submitted package bytes. Database
# initialization creates it. Do not expose this name to browser code.
AIQ_SUBMISSION_PACKAGE_BUCKET=aiq-submission-packages
# Canonical private Storage bucket for runner artifacts. Database initialization
# creates it. Routes use content-addressed keys in this bucket.
AIQ_RUNNER_ARTIFACT_BUCKET=aiq-runner-artifacts
# One-shot private Storage lifecycle worker settings. An external operator-owned
# scheduler invokes `node scripts/storage-object-lifecycle.ts`; the repository
# creates no schedule. A source checkout can use `npm run storage:lifecycle`.
# Set this explicitly for each one-shot invocation. Use `delete` for bounded
# eligible deletion. Use `reconcile` for inventory comparison, durable mismatch
# recording, and database-gated mature-orphan registration. A missing value fails closed.
# Reconciliation does not delete Storage bytes.
AIQ_STORAGE_LIFECYCLE_MODE=
AIQ_STORAGE_LIFECYCLE_BATCH_SIZE=50
AIQ_STORAGE_LIFECYCLE_LEASE_SECONDS=300
AIQ_STORAGE_RECONCILIATION_GRACE_SECONDS=86400
AIQ_STORAGE_RECONCILIATION_MAX_OBJECTS=10000
AIQ_STORAGE_REQUEST_TIMEOUT_MS=10000
# Local Supabase only. Production must use HTTPS and must leave this unset.
AIQ_STORAGE_ALLOW_INSECURE_LOOPBACK=
AIQ_VERIFIER_INGRESS_TOKEN=
# Data API publishable key. Custom role JWTs go in Authorization through
# supabase-js accessToken; the publishable key goes only in apikey.
AIQ_SUPABASE_PUBLISHABLE_KEY=
# Private ES256 JWK imported into Supabase JWT Signing Keys. The gateway uses
# it only to mint five-minute aiq_verifier and aiq_publisher role tokens. It is
# a project-wide JWT minting authority, so keep it in the protected gateway.
AIQ_SUPABASE_JWT_PRIVATE_JWK=
# Registered production publisher actor bound into aiq_publisher JWTs. Keep the
# exact node_<64 lowercase hex> ID server-only; never add a NEXT_PUBLIC alias.
AIQ_PUBLISHER_NODE_ID=

# Runner-only signing material.
AIQ_RUNNER_SIGNING_KEY=

# Verifier-only signing identity. Never give this to the runner, browser,
# publisher, or a client bundle.
AIQ_VERIFIER_SIGNING_KEY=
